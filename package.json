{
  "name": "@davidabou/icons",
  "version": "0.1.0",
  "main": "dist/index.umd.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "MIT",
  "author": "davidabou",
  "scripts": {
    "build": "bun run generate && vite build",
    "generate": "node bin/generate.js",
    "playground": "cd packages/nuxt && bun install && bun run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidabou/icons.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "svgo": "^2.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "files": [
    "dist/index.mjs",
    "dist/index.umd.js",
    "dist/index.d.ts"
  ]
}
